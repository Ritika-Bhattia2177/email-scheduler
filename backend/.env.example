PORT=5000
NODE_ENV=development

DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/DATABASE?schema=public

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

WORKER_CONCURRENCY=5

# Defaults for new email jobs. Explicit per-email minimumDelayMs/hourlyLimit values
# are persisted on that job and take precedence over these defaults.
EMAIL_DELAY_MS=1000
MAX_EMAILS_PER_HOUR=100
MAX_EMAILS_PER_SENDER_PER_HOUR=50

SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

ELASTICSEARCH_NODE=https://127.0.0.1:9200
ELASTICSEARCH_INDEX=emails
# Keep this machine-specific CA file out of Git; see the Configuration section in README.md.
ELASTICSEARCH_CA_CERT_PATH=./http_ca.crt
ELASTICSEARCH_API_KEY=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
SLACK_REDIRECT_URI=
SLACK_SCOPES=chat:write
SLACK_NOTIFICATION_CHANNEL_ID=
# Use a stable random secret of at least 32 bytes for stored-token encryption.
SLACK_TOKEN_ENCRYPTION_KEY=

# Google OpenID Connect login
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
# Use a random secret of at least 32 bytes for application session signatures.
AUTH_SESSION_SECRET=
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
AUTH_MODE=development

# Queue dashboard is local-development enabled; configure credentials before use.
BULL_BOARD_ENABLED=true
# Required when the dashboard is enabled. Set private values in .env only.
BULL_BOARD_USERNAME=admin
BULL_BOARD_PASSWORD=change-me
